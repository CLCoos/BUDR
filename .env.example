# BUDR — miljøvariabler (skabelon). Kopiér til .env.local og udfyld.
# COMMIT ALDRIG rigtige værdier. .env og .env*.local er gitignored.

# --- Supabase (offentlige) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — ALDRIG NEXT_PUBLIC) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=

# --- AI / server only ---
ANTHROPIC_API_KEY=
# Valgfrit: override af model til journal-polish
# ANTHROPIC_JOURNAL_POLISH_MODEL=
# Claude via AWS Bedrock i EU (Frankfurt) i stedet for Anthropic direkte:
# AI_PROVIDER=bedrock
# BUDR_AWS_ACCESS_KEY_ID=
# BUDR_AWS_SECRET_ACCESS_KEY=
# BUDR_AWS_REGION=eu-central-1
# BEDROCK_MODEL_HAIKU=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_MODEL_SONNET=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# --- TTS (server only) ---
ELEVENLABS_API_KEY=

# --- Analytics / betaling (offentlige, valgfrit) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GA_BYPASS_CONSENT=   # "true" kun til test
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
